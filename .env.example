# Copy to .env and fill in. Never commit .env.

# Flask
SECRET_KEY=change-me-to-a-random-value
FLASK_ENV=development

# Database
DATABASE_PATH=instance/app.db

# Default timezone for new users (IANA name)
DEFAULT_TIMEZONE=Asia/Kolkata

# Cron endpoint protection (S4)
CRON_SECRET=change-me

# Gmail SMTP for reminders (S4)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Gemini (S6, Phase 2 only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Feature flags (Phase 2, default off — flags off must equal v1.0 behaviour)
FEATURE_ESTIMATES=0
FEATURE_SMART_CAPTURE=0
FEATURE_INSIGHTS=0

# Demo seed account (scripts/seed.py)
SEED_USER_EMAIL=demo@startby.local
SEED_USER_PASSWORD=change-me
