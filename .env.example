# Copy to .env and fill in. Never commit .env.

# Flask
SECRET_KEY=change-me-to-a-random-value
FLASK_ENV=development
# Login page "DEMO demo@startby.local" autofill pill. Default: on unless FLASK_ENV=production.
# DEMO_LOGIN_HINT=1

# Database
DATABASE_PATH=instance/app.db

# Behind nginx on the VM set BEHIND_PROXY=1 (otherwise every visitor shares one
# rate limit), and SECURE_COOKIES=1 once HTTPS works. Leave 0 for local dev.
BEHIND_PROXY=0
SECURE_COOKIES=0

# Default timezone for new users (IANA name)
DEFAULT_TIMEZONE=Asia/Kolkata

# Cron endpoint protection (S4)
CRON_SECRET=change-me

# Gmail SMTP for reminders (S4)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Gemini (S6, Phase 2 only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Feature flags (Phase 2, default off — flags off must equal v1.0 behaviour)
FEATURE_ESTIMATES=0
FEATURE_SMART_CAPTURE=0
FEATURE_INSIGHTS=0
FEATURE_VOICE=0
# Default name of the spoken assistant (each user can rename it in Settings)
ASSISTANT_NAME=SARA

# Demo seed account (scripts/seed.py)
SEED_USER_EMAIL=demo@startby.local
SEED_USER_PASSWORD=change-me

# --- Google Cloud integrations (all optional; see deploy/gcp/env.production.example) ---
# Secret Manager: names listed here are fetched at boot and override .env.
GCP_PROJECT=
GCP_LOCATION=us-central1
GCP_SECRETS=
# Gemini backend: ai_studio (API key, free tier) or vertex (VM service account)
GEMINI_BACKEND=ai_studio
APP_BASE_URL=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=
PUBSUB_EVENTS_TOPIC=
BQ_DATASET=
BQ_EVENTS_TABLE=task_events
GCS_BUCKET=
MONITORING_ENABLED=0
LOG_FORMAT=text
# Google Calendar (per-user OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
