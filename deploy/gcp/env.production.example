# Non-secret production settings for /opt/startby/.env on the VM.
# Secrets (SECRET_KEY, CRON_SECRET, SMTP_PASSWORD, GEMINI_API_KEY,
# GOOGLE_CLIENT_SECRET) come from Secret Manager via GCP_SECRETS below.
FLASK_ENV=production
# Behind nginx; set SECURE_COOKIES=1 only AFTER certbot has enabled HTTPS.
BEHIND_PROXY=1
SECURE_COOKIES=0
ALLOW_DEMO_SOCIAL_LOGIN=0
DATABASE_PATH=/opt/startby/instance/app.db
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_FORMAT=json

GCP_PROJECT=your-project-id
GCP_LOCATION=us-central1
# SECRET_KEY and CRON_SECRET are required (the app refuses to start without
# them). The rest are optional: a name whose secret does not exist is skipped
# with a warning, and the feature it powers stays off.
GCP_SECRETS=SECRET_KEY,CRON_SECRET,SMTP_PASSWORD,GEMINI_API_KEY

APP_BASE_URL=https://your-domain
# ai_studio = free key (put GEMINI_API_KEY in Secret Manager + GCP_SECRETS).
# vertex = billed per token via the VM's service account: opt in deliberately.
GEMINI_BACKEND=ai_studio
GEMINI_MODEL=gemini-flash-latest

CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=start-now
PUBSUB_EVENTS_TOPIC=startby-events
BQ_DATASET=startby
BQ_EVENTS_TABLE=task_events
GCS_BUCKET=your-project-id-startby
MONITORING_ENABLED=1

# Reminders silently fail until this is a real Gmail address (+ SMTP_PASSWORD secret):
SMTP_USER=CHANGE-ME@gmail.com

# Optional: Google Calendar sync
GOOGLE_CLIENT_ID=
# (add GOOGLE_CLIENT_SECRET to GCP_SECRETS after storing it in Secret Manager)

FEATURE_ESTIMATES=1
FEATURE_SMART_CAPTURE=1
FEATURE_INSIGHTS=1
FEATURE_VOICE=1
